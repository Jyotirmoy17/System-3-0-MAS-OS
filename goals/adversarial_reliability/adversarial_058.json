{
  "id": "adversarial_058",
  "goal_type": "adversarial_reliability",
  "pipeline_depth_k": 5,
  "_placeholder": false,
  "goal_text": "(Reused from sequential_030) A factory produces 10,000 units per month. Each unit requires: 2.5 kg of material A at $4/kg, 1.2 kg of material B at $7/kg, 0.5 machine-hours at $60/hour, 0.3 labor-hours at $25/hour. Compute: (1) total material A cost, (2) total material B cost, (3) total machine time cost, (4) total labor cost, (5) total variable production cost, unit cost, and the selling price needed to achieve a 30% gross margin.",
  "inputs": {
    "units": 10000,
    "material_a_kg_per_unit": 2.5,
    "material_a_cost_per_kg": 4,
    "material_b_kg_per_unit": 1.2,
    "material_b_cost_per_kg": 7,
    "machine_hours_per_unit": 0.5,
    "machine_rate_per_hour": 60,
    "labor_hours_per_unit": 0.3,
    "labor_rate_per_hour": 25,
    "target_gross_margin": 0.3
  },
  "ground_truth": "Material A = 10000*2.5*4 = 100000; material B = 10000*1.2*7 = 84000; machine = 10000*0.5*60 = 300000; labor = 10000*0.3*25 = 75000; total = 100000+84000+300000+75000 = 559000; unit cost = 559000/10000 = 55.90; selling price = 55.90/(1-0.30) = 55.90/0.70 = 79.86",
  "rubric": [
    {
      "check_id": "c1",
      "check_text": "Answer contains key term from base goal (factory)",
      "check_type": "substring",
      "check_params": {
        "field": "answer",
        "must_contain": [
          "factory",
          "units",
          "material"
        ]
      }
    },
    {
      "check_id": "c2",
      "check_text": "No corruption markers leaked into final answer",
      "check_type": "substring",
      "check_params": {
        "field": "answer",
        "must_contain": [],
        "must_not_contain": [
          "null",
          "undefined",
          "[object Object]",
          "NaN",
          "syntax error",
          "CORRUPTED"
        ]
      }
    }
  ],
  "corruption_pattern": "out_of_range"
}
