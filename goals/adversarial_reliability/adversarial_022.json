    "x_machine_hours": 3,
    "x_labor_hours": 2,
    "x_profit": 20,
    "y_machine_hours": 1,
    "y_labor_hours": 4,
    "y_profit": 15,
    "machine_capacity": 180,
    "labor_capacity": 200
  },
  "ground_truth": "Constraints: 3X+Y\u2264180, 2X+4Y\u2264200, X,Y\u22650. Corner points: (0,0)\u21920; (60,0)\u21921200; (0,50)\u2192750; intersection 3X+Y=180 and 2X+4Y=200: Y=180-3X, 2X+4(180-3X)=200, -10X=-520, X=52, Y=24, profit=20*52+15*24=1040+360=1400. Optimal: X=52, Y=24, max profit=$1400/week.",
