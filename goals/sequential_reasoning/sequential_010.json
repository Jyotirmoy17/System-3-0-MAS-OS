{
  "id": "sequential_010",
  "goal_type": "sequential_reasoning",
  "pipeline_depth_k": 3,
  "_placeholder": false,
  "goal_text": "An investment of $8,000 earns 5% annual interest compounded quarterly. What is the value of the investment after 3 years? Show the quarterly rate, number of compounding periods, and final value.",
  "inputs": {
    "principal": 8000,
    "annual_rate": 0.05,
    "years": 3,
    "compounding": "quarterly"
  },
  "ground_truth": "Quarterly rate = 0.05/4 = 0.0125; periods = 3*4 = 12; FV = 8000*(1.0125)^12; (1.0125)^12 \u2248 1.16075; FV = 8000*1.16075 = 9286",
  "rubric": [
    {
      "check_id": "c1",
      "check_text": "Future value near 9286",
      "check_type": "numeric",
      "check_params": {
        "field": "answer",
        "expected": 9286,
        "tolerance": 5
      }
    },
    {
      "check_id": "c2",
      "check_text": "Mentions quarterly rate 0.0125",
      "check_type": "substring",
      "check_params": {
        "field": "answer",
        "must_contain": [
          "0.0125",
          "1.0125",
          "quarterly rate"
        ]
      }
    },
    {
      "check_id": "c3",
      "check_text": "States 12 compounding periods",
      "check_type": "substring",
      "check_params": {
        "field": "answer",
        "must_contain": [
          "12 period",
          "12 quarter",
          "n=12"
        ]
      }
    }
  ],
  "corruption_pattern": null
}
