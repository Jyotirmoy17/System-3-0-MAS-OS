{
  "id": "sequential_009",
  "goal_type": "sequential_reasoning",
  "pipeline_depth_k": 3,
  "_placeholder": false,
  "goal_text": "A startup has 3 sales representatives each making 8 calls per day, with a 15% call-to-meeting conversion rate, a 25% meeting-to-closed-sale conversion rate, and an average deal value of $4,200. Assuming 22 working days per month, compute: monthly calls, meetings, closed deals, and monthly revenue.",
  "inputs": {
    "reps": 3,
    "calls_per_rep_per_day": 8,
    "call_to_meeting_rate": 0.15,
    "meeting_to_sale_rate": 0.25,
    "avg_deal_value": 4200,
    "working_days": 22
  },
  "ground_truth": "Monthly calls = 3*8*22 = 528; meetings = 528*0.15 = 79.2; closed deals = 79.2*0.25 = 19.8; monthly revenue = 19.8*4200 = 83160",
  "rubric": [
    {
      "check_id": "c1",
      "check_text": "Monthly revenue near 83160",
      "check_type": "numeric",
      "check_params": {
        "field": "answer",
        "expected": 83160,
        "tolerance": 500
      }
    },
    {
      "check_id": "c2",
      "check_text": "Mentions 528 calls and 79.2 meetings",
      "check_type": "substring",
      "check_params": {
        "field": "answer",
        "must_contain": [
          "528",
          "79.2"
        ]
      }
    },
    {
      "check_id": "c3",
      "check_text": "Monthly revenue 83160 stated",
      "check_type": "substring",
      "check_params": {
        "field": "answer",
        "must_contain": [
          "83160",
          "83,160"
        ]
      }
    }
  ],
  "corruption_pattern": null
}
