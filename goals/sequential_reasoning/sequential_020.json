    "mean": 72,
    "sd": 8,
    "boost": 5,
    "frac": 0.3,
    "thresh": 60
  },
  "ground_truth": "36 papers +5; new mean \u2248 73.5",
  "rubric": [
    {
      "check_id": "c1",
      "check_text": "Final numeric anchor",
      "check_type": "numeric",
      "check_params": {
        "field": "answer",
        "expected": 73.5,
        "tolerance": 50
      }
    },
    {
      "check_id": "c2",
      "check_text": "Intermediate steps present",
      "check_type": "substring",
      "check_params": {
        "field": "answer",
        "must_contain": [
          "73.5",
          "regrade",
          "mean"
        ]
      }
    },
    {
      "check_id": "c3",
      "check_text": "Step-1 sensitivity noted",
      "check_type": "substring",
      "check_params": {
        "field": "answer",
        "must_contain": [
          "step 1",
