{
  "id": "sequential_020",
  "goal_type": "sequential_reasoning",
  "pipeline_depth_k": 4,
  "_placeholder": false,
  "goal_text": "Exam grading: 120 papers, machine score mean 72 with SD 8, human regrade +5 on below 60 (30% of papers), new mean?",
